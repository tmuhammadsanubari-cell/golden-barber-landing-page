---
import Badge from '@/components/ui/Badge';
import Icon from '@/components/ui/Icon';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tabs from '@/components/ui/Tabs.astro';
import { formatHours } from '@/lib/format';
import { buildMapsUrl, formatAddress } from '@/lib/maps';
import { whatsAppLinkProps } from '@/lib/whatsapp';
import type { Branch, Region, SiteSettings } from '@/types/content';

interface Props {
  settings: SiteSettings;
  branches: Branch[];
}

const { settings, branches } = Astro.props;

const regions: { key: Region; id: string; label: string }[] = [
  { key: 'bandung_raya', id: 'wilayah-bandung', label: 'Bandung Raya' },
  { key: 'jabodetabek', id: 'wilayah-jabodetabek', label: 'Jabodetabek' },
];
const inRegion = (key: Region) => branches.filter((branch) => branch.region === key);
const tabs = regions.map((region) => ({
  id: region.id,
  label: `${region.label} (${inRegion(region.key).length})`,
}));
const hours = formatHours(branches[0]!.open_time, branches[0]!.close_time);
---

<section id="cabang" aria-labelledby="cab-h" class="border-y border-line bg-alt">
  <div class="wrap pt-12 pb-14 lg:py-24">
    <SectionHeading
      id="cab-h"
      label="Cabang Kami"
      tagline={`${branches.length} lokasi`}
      class="mb-[18px] lg:mb-8"
    >
      Datang langsung ke<br class="hidden lg:block" /> cabang terdekat.
      <p slot="aside" class="body-text hidden max-w-[420px] lg:block">
        Semua cabang buka setiap hari {hours}. Booking dulu via WhatsApp supaya tidak antre.
      </p>
    </SectionHeading>

    <Tabs label="Wilayah cabang" tabs={tabs}>
      {
        regions.map((region, regionIndex) => (
          <div
            id={region.id}
            role="tabpanel"
            aria-labelledby={`tab-${region.id}`}
            hidden={regionIndex !== 0}
            class="grid gap-3 md:grid-cols-2 lg:gap-5 xl:grid-cols-4"
          >
            {inRegion(region.key).map((branch) => (
              <article class="card flex flex-col gap-2.5 p-[18px] lg:min-h-[330px] lg:gap-3.5 lg:p-[22px]">
                <div class="flex items-center justify-between gap-2 lg:order-first lg:min-h-[22px] lg:justify-start">
                  <h3 class="m-0 font-display text-[19px] font-extrabold uppercase lg:hidden">
                    {branch.name}
                  </h3>
                  {branch.is_flagship && <Badge variant="pusat">Pusat</Badge>}
                  {branch.is_new && <Badge variant="baru">Cabang Baru</Badge>}
                  {!branch.is_flagship && !branch.is_new && (
                    <span class="lbl hidden !text-[11px] lg:inline">{region.label}</span>
                  )}
                </div>
                <h3 class="m-0 hidden font-display text-[22px] font-extrabold tracking-[0.01em] uppercase lg:block">
                  {branch.name}
                </h3>
                <div class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex-none text-ink-muted">
                    <Icon name="pin" size={18} />
                  </span>
                  <p class="m-0 text-[15px] leading-normal">{formatAddress(branch)}</p>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="flex-none text-ink-muted">
                    <Icon name="clock" size={18} />
                  </span>
                  <p class="m-0 text-[15px] text-ink-muted">
                    Setiap hari {formatHours(branch.open_time, branch.close_time)}
                  </p>
                </div>
                {branch.address_incomplete && (
                  <p class="m-0 text-[13px] text-ink-muted italic">
                    Alamat lengkap: tanyakan via WhatsApp
                  </p>
                )}
                <div class="mt-auto grid grid-cols-3 gap-1.5 pt-1 xl:grid-cols-2 xl:gap-2 xl:pt-0">
                  <a
                    class="btn btn-s !px-1.5 xl:col-span-2"
                    aria-label={`Booking WA cabang ${branch.name}`}
                    {...whatsAppLinkProps({ context: 'branch', settings, branch })}
                  >
                    Booking WA
                  </a>
                  <a
                    class="btn-o btn-s !px-1.5"
                    href={buildMapsUrl(branch)}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Petunjuk arah ke cabang ${branch.name}`}
                  >
                    <span class="xl:hidden">Arah</span>
                    <span class="hidden xl:inline">Petunjuk Arah</span>
                  </a>
                  <a
                    class="btn-o btn-s !px-1.5"
                    href={`/?cabang=${branch.slug}#harga`}
                    data-pick-branch={branch.slug}
                    aria-label={`Lihat harga cabang ${branch.name}`}
                  >
                    Lihat Harga
                  </a>
                </div>
                <a
                  class="inline-flex min-h-11 items-center justify-center gap-1 text-sm font-bold"
                  href={`/cabang/${branch.slug}`}
                  aria-label={`Detail cabang ${branch.name}`}
                >
                  Detail Cabang
                  <Icon name="chevron-right" size={16} />
                </a>
              </article>
            ))}
          </div>
        ))
      }
    </Tabs>
  </div>
</section>

<script>
  import { selectBranch } from '@/lib/stores';

  // Tautan "Lihat Harga" (kartu & footer): pilih cabang tanpa muat ulang halaman.
  // Tanpa JS, href `/?cabang=slug#harga` tetap berfungsi.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLElement>('[data-pick-branch]');
    if (!link) return;
    event.preventDefault();
    selectBranch(link.dataset.pickBranch!);
    document.getElementById('harga')?.scrollIntoView();
  });
</script>
