---
import { Image } from 'astro:assets';
import Badge from '@/components/ui/Badge';
import Icon from '@/components/ui/Icon';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { GalleryItem } from '@/types/content';

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<section id="galeri" aria-labelledby="gal-h" class="border-y border-line lg:bg-alt">
  <div class="wrap py-12 lg:py-24">
    <SectionHeading id="gal-h" label="Galeri" tagline="Model rambut" class="mb-4 lg:mb-10">
      Inspirasi buat konsultasi.
      <p slot="aside" class="body-text hidden max-w-[420px] lg:block">
        Tunjukkan model yang kamu suka ke barber — mereka bantu sesuaikan.
      </p>
    </SectionHeading>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-5">
      {items.map((item, index) => (
        <figure class="m-0 overflow-hidden rounded-gb border border-line bg-surface">
          <button
            type="button"
            class="ph relative block aspect-square w-full p-0"
            data-lightbox-index={index}
            aria-label={`Perbesar foto ${item.title}${item.is_placeholder ? ' (Ilustrasi)' : ''}`}
          >
            <Image
              src={item.image_path}
              alt={item.alt_text}
              width={300}
              height={300}
              class="size-full object-cover"
            />
            {item.is_placeholder && (
              <span aria-hidden="true">
                <Badge variant="photo" className="absolute top-2.5 left-2.5 lg:top-3.5 lg:left-3.5">
                  Ilustrasi
                </Badge>
              </span>
            )}
          </button>
          <figcaption class="min-h-14 px-3 py-2.5 font-display text-sm leading-[1.3] font-bold lg:min-h-0 lg:px-4 lg:py-3.5 lg:text-base">
            {item.title}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  aria-label="Foto model rambut"
  class="m-auto w-[min(92vw,720px)] overflow-visible bg-transparent p-0 backdrop:bg-[rgba(30,33,33,0.85)]"
>
  <div class="flex flex-col gap-3 rounded-gb bg-surface p-3 lg:p-4">
    <div class="flex items-center justify-between gap-3">
      <p id="lightbox-title" class="m-0 font-display text-base font-bold lg:text-lg"></p>
      <button type="button" class="ic flex-none" data-lightbox-close aria-label="Tutup foto">
        <Icon name="close" />
      </button>
    </div>
    <div class="ph relative">
      <img id="lightbox-image" src="" alt="" class="max-h-[70vh] w-full object-contain" />
      <Badge variant="photo" className="absolute top-3 left-3 hidden">
        Ilustrasi
      </Badge>
    </div>
    <p id="lightbox-description" class="m-0 text-[15px] leading-normal text-ink-muted"></p>
    <div class="flex justify-between">
      <button type="button" class="ic" data-lightbox-step="-1" aria-label="Foto sebelumnya">
        <Icon name="chevron-left" />
      </button>
      <button type="button" class="ic" data-lightbox-step="1" aria-label="Foto berikutnya">
        <Icon name="chevron-right" />
      </button>
    </div>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  id="lightbox-data"
  set:html={JSON.stringify(items).replace(/</g, '\u003c')}
/>
<script>
  import type { GalleryItem } from '@/types/content';

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const items = JSON.parse(document.getElementById('lightbox-data')!.textContent!) as GalleryItem[];
  const image = document.getElementById('lightbox-image') as HTMLImageElement;
  const title = document.getElementById('lightbox-title')!;
  const description = document.getElementById('lightbox-description')!;
  const tag = dialog.querySelector('.tag')!;
  let current = 0;

  const show = (index: number) => {
    current = (index + items.length) % items.length;
    const item = items[current]!;
    image.src = item.image_path;
    image.alt = item.alt_text;
    title.textContent = item.title;
    description.textContent = item.description ?? '';
    tag.classList.toggle('hidden', !item.is_placeholder);
  };

  document.querySelectorAll<HTMLElement>('[data-lightbox-index]').forEach((button) => {
    button.addEventListener('click', () => {
      show(Number(button.dataset.lightboxIndex));
      dialog.showModal();
    });
  });
  dialog.querySelectorAll<HTMLElement>('[data-lightbox-step]').forEach((button) => {
    button.addEventListener('click', () => show(current + Number(button.dataset.lightboxStep)));
  });
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
  // Klik latar: target dialog itu sendiri, karena isinya mengisi seluruh kotak dialog.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });
</script>
