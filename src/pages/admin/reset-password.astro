---
// Halaman reset password (PRD F-14). Tautan email membawa ?code=...; ditukar menjadi sesi di
// server, lalu URL dibersihkan agar kode sekali-pakai tidak tertinggal di riwayat browser.
import ResetPasswordForm from '@/components/admin/ResetPasswordForm';
import AdminLayout from '@/layouts/AdminLayout.astro';

export const prerender = false;

const { supabase } = Astro.locals;
const code = Astro.url.searchParams.get('code');
if (code) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) console.error('[reset-password] gagal menukar kode', error.message);
  return Astro.redirect(error ? '/admin/reset-password?error=1' : '/admin/reset-password');
}

const { data } = await supabase.auth.getUser();
const hasSession = Boolean(data.user);
---

<AdminLayout title="Atur password" bare>
  <style is:global>
    /* Tautan undangan membawa token di fragmen URL; selama diproses, jangan tampilkan galat. */
    #invite-wait {
      display: none;
    }
    html[data-invite='1'] #invite-wait {
      display: flex;
    }
    html[data-invite='1'] #reset-main-content {
      display: none;
    }
  </style>
  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.hash.slice(1));
      const access = params.get('access_token');
      const refresh = params.get('refresh_token');
      if (!access || !refresh) return;
      document.documentElement.setAttribute('data-invite', '1');
      history.replaceState(null, '', window.location.pathname + window.location.search);
      fetch('/api/auth/set-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ access_token: access, refresh_token: refresh }),
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (json) {
          if (json && json.success) {
            window.location.replace('/admin/reset-password');
            return;
          }
          document.documentElement.removeAttribute('data-invite');
          window.location.replace('/admin/reset-password?error=1');
        })
        .catch(function () {
          document.documentElement.removeAttribute('data-invite');
        });
    })();
  </script>
  <div class="auth">
    <main class="auth-main" style="flex:1">
      <div class="auth-card" id="invite-wait" role="status">
        <h1 class="h1" style="font-size:24px;margin-bottom:6px">Memproses undangan…</h1>
        <p style="margin:0;font-size:14px;color:#5b6161">Sebentar, Anda akan diminta membuat password.</p>
      </div>
      <div id="reset-main-content">
      {hasSession ? (
        <ResetPasswordForm client:load />
      ) : (
        <div class="auth-card">
          <div>
            <h1 class="h1" style="font-size:24px;margin-bottom:6px">
              Tautan tidak berlaku
            </h1>
            <p style="margin:0;font-size:14px;color:#5b6161">
              Tautan reset password sudah kedaluwarsa atau sudah dipakai. Minta tautan baru dari
              halaman masuk.
            </p>
          </div>
          <a class="btn" href="/admin/login">
            Ke halaman masuk
          </a>
        </div>
      )}
      </div>
    </main>
  </div>
</AdminLayout>
